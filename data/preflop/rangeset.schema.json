{
 "$defs": {
  "handActions": {
   "additionalProperties": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "minProperties": 1,
   "propertyNames": {
    "enum": [
     "fold",
     "call",
     "raise",
     "three_bet",
     "four_bet"
    ]
   },
   "type": "object"
  },
  "sourceBlock": {
   "additionalProperties": false,
   "properties": {
    "licence": {
     "minLength": 1,
     "type": "string"
    },
    "name": {
     "minLength": 1,
     "type": "string"
    },
    "retrieved": {
     "format": "date",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "url": {
     "pattern": "^https?://\\S+$",
     "type": "string"
    }
   },
   "required": [
    "name",
    "licence",
    "retrieved"
   ],
   "type": "object"
  }
 },
 "$id": "rangeset.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "allOf": [
  {
   "if": {
    "properties": {
     "table_size": {
      "const": "6max"
     }
    },
    "required": [
     "table_size"
    ]
   },
   "then": {
    "properties": {
     "position": {
      "enum": [
       "UTG",
       "MP",
       "CO",
       "BTN",
       "SB",
       "BB"
      ]
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "table_size": {
      "const": "9max"
     }
    },
    "required": [
     "table_size"
    ]
   },
   "then": {
    "properties": {
     "position": {
      "enum": [
       "UTG",
       "UTG+1",
       "UTG+2",
       "LJ",
       "HJ",
       "CO",
       "BTN",
       "SB",
       "BB"
      ]
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "context": {
      "const": "sb_play"
     }
    },
    "required": [
     "context"
    ]
   },
   "then": {
    "properties": {
     "position": {
      "const": "SB"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "context": {
      "const": "rfi"
     }
    },
    "required": [
     "context"
    ]
   },
   "then": {
    "properties": {
     "hands": {
      "additionalProperties": {
       "propertyNames": {
        "enum": [
         "fold",
         "raise"
        ]
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "context": {
      "const": "vs_rfi"
     }
    },
    "required": [
     "context"
    ]
   },
   "then": {
    "properties": {
     "hands": {
      "additionalProperties": {
       "propertyNames": {
        "enum": [
         "fold",
         "call",
         "three_bet"
        ]
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "context": {
      "const": "three_bet"
     }
    },
    "required": [
     "context"
    ]
   },
   "then": {
    "properties": {
     "hands": {
      "additionalProperties": {
       "propertyNames": {
        "enum": [
         "fold",
         "call",
         "four_bet"
        ]
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "context": {
      "const": "sb_play"
     }
    },
    "required": [
     "context"
    ]
   },
   "then": {
    "properties": {
     "hands": {
      "additionalProperties": {
       "propertyNames": {
        "enum": [
         "fold",
         "call",
         "raise",
         "three_bet"
        ]
       }
      }
     }
    }
   }
  },
  {
   "if": {
    "not": {
     "required": [
      "provenance"
     ]
    }
   },
   "then": {
    "required": [
     "source"
    ]
   }
  },
  {
   "if": {
    "properties": {
     "provenance": {
      "properties": {
       "sources": {
        "maxItems": 0
       }
      },
      "required": [
       "sources"
      ]
     }
    },
    "required": [
     "provenance"
    ]
   },
   "then": {
    "properties": {
     "provenance": {
      "required": [
       "derivation"
      ]
     }
    }
   }
  }
 ],
 "description": "One preflop starting-range chart for one table size, position, decision context and stack depth, transcribed from a single licence-verified source. Hand keys are canonical representative combos (see README.md in this directory); values map actions to frequencies in [0, 1]. Importers must additionally enforce: card distinctness, non-increasing rank order, canonical suit labelling, per-context action sets, and per-hand frequencies summing to 1 (within rounding tolerance). Amendment 2026-11-07 (constructed ranges): a set built by build-ranges carries a 'provenance' block (method, tool, config version/hash, cross-check sources) instead of a single transcribed-chart 'source'; 'source' is then optional, and a provenance with an empty sources list must state its 'derivation'. The top-level 'source' rules are unchanged for transcribed charts.",
 "properties": {
  "context": {
   "description": "rfi = first-in decision; vs_rfi = facing a single open raise (the three_bet action lives here); three_bet = facing a three-bet; sb_play = small-blind first-in/completion decisions.",
   "enum": [
    "rfi",
    "vs_rfi",
    "three_bet",
    "sb_play"
   ]
  },
  "context_detail": {
   "description": "Optional specifics the enum cannot carry, e.g. the opener's position for vs_rfi or the three-bettor's position for three_bet, exactly as stated by the source.",
   "maxLength": 500,
   "type": "string"
  },
  "hands": {
   "additionalProperties": {
    "$ref": "#/$defs/handActions"
   },
   "minProperties": 1,
   "propertyNames": {
    "pattern": "^[AKQJT98765432][shdc]( [AKQJT98765432][shdc]){3}$"
   },
   "type": "object"
  },
  "id": {
   "description": "Stable slug identifying this range set, e.g. publisher-context-position-stack.",
   "pattern": "^[a-z0-9][a-z0-9._-]*$",
   "type": "string"
  },
  "notes": {
   "maxLength": 2000,
   "type": "string"
  },
  "position": {
   "enum": [
    "UTG",
    "UTG+1",
    "UTG+2",
    "MP",
    "LJ",
    "HJ",
    "CO",
    "BTN",
    "SB",
    "BB"
   ]
  },
  "provenance": {
   "additionalProperties": false,
   "description": "Construction provenance for sets built by our own tooling (method constructed-equity-v1). 'sources' lists cross-check sources only (published totals cited for validation; range data itself is constructed, never transcribed). Empty for derived sets, which must then carry 'derivation'. Added by the 2026-11-07 constructed-ranges amendment; transcribed single-source charts do not use this block and still require 'source'.",
   "properties": {
    "config_hash": {
     "minLength": 1,
     "type": "string"
    },
    "config_version": {
     "minLength": 1,
     "type": "string"
    },
    "derivation": {
     "maxLength": 1000,
     "type": "string"
    },
    "method": {
     "minLength": 1,
     "type": "string"
    },
    "sources": {
     "items": {
      "$ref": "#/$defs/sourceBlock"
     },
     "type": "array"
    },
    "tool": {
     "minLength": 1,
     "type": "string"
    },
    "tool_version": {
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "method",
    "sources"
   ],
   "type": "object"
  },
  "rake_note": {
   "description": "Rake structure assumption stated by the source, or an explicit note that the source does not state one.",
   "minLength": 1,
   "type": "string"
  },
  "schema_version": {
   "const": 1
  },
  "source": {
   "additionalProperties": false,
   "properties": {
    "licence": {
     "description": "Licence / terms basis under which the data may be stored and used in this personal tool, as verified by the coordinator before the entry is added.",
     "minLength": 1,
     "type": "string"
    },
    "name": {
     "minLength": 1,
     "type": "string"
    },
    "retrieved": {
     "format": "date",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "url": {
     "pattern": "^https?://\\S+$",
     "type": "string"
    }
   },
   "required": [
    "name",
    "url",
    "licence",
    "retrieved"
   ],
   "type": "object"
  },
  "stack_bb": {
   "description": "Effective stack depth in big blinds the chart was computed/published for.",
   "exclusiveMinimum": 0,
   "maximum": 1000,
   "type": "number"
  },
  "table_size": {
   "enum": [
    "6max",
    "9max"
   ]
  }
 },
 "required": [
  "schema_version",
  "id",
  "table_size",
  "position",
  "context",
  "stack_bb",
  "rake_note",
  "hands"
 ],
 "title": "PLO4 preflop range set",
 "type": "object"
}